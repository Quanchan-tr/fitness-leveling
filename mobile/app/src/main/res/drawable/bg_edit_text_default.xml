<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="@dimen/border_width_active" android:color="@color/border_focused" />
            <corners android:radius="@dimen/radius_input" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="@dimen/border_width_standard" android:color="@color/border_card" />
            <corners android:radius="@dimen/radius_input" />
        </shape>
    </item>
</selector>
