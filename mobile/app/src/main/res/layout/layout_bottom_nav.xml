<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_nav_container"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@color/white"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <!-- Tab 1: Dashboard -->
    <LinearLayout
        android:id="@+id/nav_item_dashboard"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_nav_icon_dashboard"
            android:layout_width="@dimen/nav_icon_size"
            android:layout_height="@dimen/nav_icon_size"
            android:contentDescription="@string/nav_dashboard"
            app:srcCompat="@drawable/ic_nav_dashboard"
            app:tint="@color/nav_inactive" />

        <TextView
            android:id="@+id/tv_nav_label_dashboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/nav_dashboard"
            android:textColor="@color/nav_inactive"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Tab 2: Workouts -->
    <LinearLayout
        android:id="@+id/nav_item_workouts"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_nav_icon_workouts"
            android:layout_width="@dimen/nav_icon_size"
            android:layout_height="@dimen/nav_icon_size"
            android:contentDescription="@string/nav_workouts"
            app:srcCompat="@drawable/ic_nav_workouts"
            app:tint="@color/nav_inactive" />

        <TextView
            android:id="@+id/tv_nav_label_workouts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/nav_workouts"
            android:textColor="@color/nav_inactive"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Tab 3: Metrics -->
    <LinearLayout
        android:id="@+id/nav_item_metrics"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_nav_icon_metrics"
            android:layout_width="@dimen/nav_icon_size"
            android:layout_height="@dimen/nav_icon_size"
            android:contentDescription="@string/nav_metrics"
            app:srcCompat="@drawable/ic_nav_metrics"
            app:tint="@color/nav_inactive" />

        <TextView
            android:id="@+id/tv_nav_label_metrics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/nav_metrics"
            android:textColor="@color/nav_inactive"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Tab 4: Community -->
    <LinearLayout
        android:id="@+id/nav_item_community"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_nav_icon_community"
            android:layout_width="@dimen/nav_icon_size"
            android:layout_height="@dimen/nav_icon_size"
            android:contentDescription="@string/nav_community"
            app:srcCompat="@drawable/ic_nav_community"
            app:tint="@color/nav_inactive" />

        <TextView
            android:id="@+id/tv_nav_label_community"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/nav_community"
            android:textColor="@color/nav_inactive"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Tab 5: Profile -->
    <LinearLayout
        android:id="@+id/nav_item_profile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_nav_icon_profile"
            android:layout_width="@dimen/nav_icon_size"
            android:layout_height="@dimen/nav_icon_size"
            android:contentDescription="@string/nav_profile"
            app:srcCompat="@drawable/ic_nav_profile"
            app:tint="@color/nav_inactive" />

        <TextView
            android:id="@+id/tv_nav_label_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/nav_profile"
            android:textColor="@color/nav_inactive"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
