<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_modal_card_white"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tv_dialog_combo_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🍗 Combo Tăng Cơ Chuẩn"
        android:textColor="@color/text_dark"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Thành phần dinh dưỡng:"
        android:textColor="@color/text_slate"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_dialog_combo_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_tag_chip"
        android:lineSpacingExtra="4dp"
        android:padding="12dp"
        android:text="• 200g Ức gà áp chảo\n• 150g Cơm gạo lứt\n• 100g Bông cải xanh"
        android:textColor="@color/text_dark"
        android:textSize="12.5sp" />

    <!-- Nutrition Macros Box -->
    <TextView
        android:id="@+id/tv_dialog_macros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_selectable"
        android:gravity="center"
        android:padding="12dp"
        android:text="⚡ 520 kcal  •  🍗 48g Đạm  •  🍚 55g Carb  •  🥑 12g Béo"
        android:textColor="@color/primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Meal Time Selector (Sáng / Trưa / Tối) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Thêm vào bữa ăn:"
        android:textColor="@color/text_slate"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip_combo_breakfast"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_subtab_pill_inactive"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Sáng"
            android:textColor="@color/subtab_pill_inactive_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chip_combo_lunch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_subtab_pill_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Trưa"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chip_combo_dinner"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_subtab_pill_inactive"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Tối"
            android:textColor="@color/subtab_pill_inactive_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Dialog Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_close"
            style="@style/Widget.FitTrack.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:backgroundTint="@color/segment_bg"
            android:text="Đóng"
            android:textColor="@color/text_dark"
            android:textSize="13sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/transparent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_add_meal"
            style="@style/Widget.FitTrack.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1.6"
            android:text="Thêm vào bữa ăn"
            android:textSize="13sp"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>