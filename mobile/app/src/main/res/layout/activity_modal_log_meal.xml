<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/modal_overlay"
    android:clickable="true"
    android:focusable="true"
    tools:context=".ui.modal.LogMealModalActivity">

    <!-- Modal Card Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_modal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_modal_card_white"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Bar -->
        <TextView
            android:id="@+id/tv_modal_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/modal_meal_title"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/btn_close_meal"
            app:layout_constraintEnd_toStartOf="@+id/btn_close_meal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/btn_close_meal"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_modal_circle_close_light"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/modal_chip_gray_text"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Segmented Tabs (Library Search vs Combo Mode) -->
        <LinearLayout
            android:id="@+id/layout_mode_tabs"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_segmented_container"
            android:orientation="horizontal"
            android:padding="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_close_meal">

            <TextView
                android:id="@+id/tab_search_library"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_primary_button"
                android:gravity="center"
                android:text="@string/modal_meal_tab_search"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tab_combo_mode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/modal_meal_tab_combo"
                android:textColor="@color/modal_chip_gray_text"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Search Input Box -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_search_food"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_modal_food_item"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_mode_tabs">

            <EditText
                android:id="@+id/et_search_food"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/modal_meal_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/modal_chip_gray_text"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Category Filter Chips -->
        <HorizontalScrollView
            android:id="@+id/scroll_category_chips"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:overScrollMode="never"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_search_food">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_meal_all"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_modal_chip_orange"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/modal_meal_chip_all"
                    android:textColor="@color/primary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_meal_protein"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_modal_food_item"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/modal_meal_chip_protein"
                    android:textColor="@color/modal_chip_gray_text"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/chip_meal_carb"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_modal_food_item"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/modal_meal_chip_carb"
                    android:textColor="@color/modal_chip_gray_text"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/chip_meal_veggie"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_modal_food_item"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/modal_meal_chip_veggie"
                    android:textColor="@color/modal_chip_gray_text"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/chip_meal_whey"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_modal_food_item"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/modal_meal_chip_whey"
                    android:textColor="@color/modal_chip_gray_text"
                    android:textSize="10sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Food Search Results List -->
        <LinearLayout
            android:id="@+id/layout_food_results"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scroll_category_chips">

            <!-- Food Item 1 (Chicken Breast) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/item_food_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_modal_food_item"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tv_food1_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/modal_meal_food1_name"
                    android:textColor="@color/text_dark"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/btn_add_food1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_food1_macro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/modal_meal_food1_macro"
                    android:textColor="@color/modal_chip_gray_text"
                    android:textSize="9sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_food1_name" />

                <TextView
                    android:id="@+id/btn_add_food1"
                    android:layout_width="54dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_modal_chip_orange"
                    android:gravity="center"
                    android:text="@string/modal_meal_btn_add_item"
                    android:textColor="@color/primary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Food Item 2 (Brown Rice) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/item_food_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_modal_food_item"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tv_food2_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/modal_meal_food2_name"
                    android:textColor="@color/text_dark"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/btn_add_food2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_food2_macro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/modal_meal_food2_macro"
                    android:textColor="@color/modal_chip_gray_text"
                    android:textSize="9sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_food2_name" />

                <TextView
                    android:id="@+id/btn_add_food2"
                    android:layout_width="54dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_modal_chip_orange"
                    android:gravity="center"
                    android:text="@string/modal_meal_btn_add_item"
                    android:textColor="@color/primary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Food Item 3 (Boiled Eggs) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/item_food_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_modal_food_item"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tv_food3_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/modal_meal_food3_name"
                    android:textColor="@color/text_dark"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/btn_add_food3"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_food3_macro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/modal_meal_food3_macro"
                    android:textColor="@color/modal_chip_gray_text"
                    android:textSize="9sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_food3_name" />

                <TextView
                    android:id="@+id/btn_add_food3"
                    android:layout_width="54dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_modal_chip_orange"
                    android:gravity="center"
                    android:text="@string/modal_meal_btn_add_item"
                    android:textColor="@color/primary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <!-- Button Confirm Save Meal -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_add_meal"
            style="@style/Widget.FitTrack.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:text="@string/modal_meal_btn_confirm"
            android:textSize="12sp"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_food_results" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
