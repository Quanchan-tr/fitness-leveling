<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/modal_overlay"
    android:clickable="true"
    android:focusable="true"
    tools:context=".ui.modal.LogMealModalActivity">

    <!-- Modal Card Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_modal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_modal_card_white"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Bar -->
        <TextView
            android:id="@+id/tv_modal_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/modal_meal_title"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/btn_close_meal"
            app:layout_constraintEnd_toStartOf="@+id/btn_close_meal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btn_close_meal"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_modal_circle_close_light"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:contentDescription="@string/cd_close"
            app:srcCompat="@drawable/ic_close"
            app:tint="@color/modal_chip_gray_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Meal Type Selector: Sáng / Trưa / Tối / Phụ -->
        <LinearLayout
            android:id="@+id/layout_meal_type_selector"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_close_meal">

            <TextView
                android:id="@+id/chip_meal_breakfast"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_modal_food_item"
                android:gravity="center"
                android:text="Sáng"
                android:textColor="@color/modal_chip_gray_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_meal_lunch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_modal_chip_orange"
                android:gravity="center"
                android:text="Trưa"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_meal_dinner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_modal_food_item"
                android:gravity="center"
                android:text="Tối"
                android:textColor="@color/modal_chip_gray_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_meal_snack"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_modal_food_item"
                android:gravity="center"
                android:text="Phụ"
                android:textColor="@color/modal_chip_gray_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Search Input Box -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_search_food"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_modal_food_item"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_meal_type_selector">

            <EditText
                android:id="@+id/et_search_food"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/modal_meal_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/modal_chip_gray_text"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Category Filter Chips -->
        <HorizontalScrollView
            android:id="@+id/scroll_category_chips"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:overScrollMode="never"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_search_food">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_meal_all"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_modal_chip_orange"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/modal_meal_chip_all"
                    android:textColor="@color/primary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_meal_protein"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_modal_food_item"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/modal_meal_chip_protein"
                    android:textColor="@color/modal_chip_gray_text"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/chip_meal_carb"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_modal_food_item"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/modal_meal_chip_carb"
                    android:textColor="@color/modal_chip_gray_text"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/chip_meal_veggie"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_modal_food_item"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/modal_meal_chip_veggie"
                    android:textColor="@color/modal_chip_gray_text"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/chip_meal_whey"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_modal_food_item"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/modal_meal_chip_whey"
                    android:textColor="@color/modal_chip_gray_text"
                    android:textSize="10sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Food Search Results Scroll Container -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_food_results"
            android:layout_width="0dp"
            android:layout_height="230dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="vertical"
            app:layout_constraintBottom_toTopOf="@+id/btn_confirm_add_meal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scroll_category_chips">

            <LinearLayout
                android:id="@+id/layout_food_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>

        <!-- Button Confirm Save Meal -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_add_meal"
            style="@style/Widget.FitTrack.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:text="@string/modal_meal_btn_confirm"
            android:textSize="12sp"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scroll_food_results" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
