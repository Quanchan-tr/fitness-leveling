<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_modal_card_white"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Food Title -->
    <TextView
        android:id="@+id/tv_edit_food_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ức gà áp chảo (100g)"
        android:textColor="@color/text_dark"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_edit_meal_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Bữa ăn: Bữa trưa"
        android:textColor="@color/text_slate"
        android:textSize="11.5sp" />

    <!-- Nutrition Macros Box -->
    <TextView
        android:id="@+id/tv_edit_macros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card_selectable"
        android:gravity="center"
        android:padding="12dp"
        android:text="⚡ 165 kcal  •  🍗 31g Đạm  •  🍚 0g Carb  •  🥑 3.6g Béo"
        android:textColor="@color/primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Portion Slider Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Khẩu phần:"
            android:textColor="@color/text_dark"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_edit_portion_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="100% (Tiêu chuẩn)"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/slider_edit_portion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="200"
        android:progress="100"
        android:progressTint="@color/primary"
        android:thumbTint="@color/primary" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_cancel"
            style="@style/Widget.FitTrack.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:backgroundTint="@color/segment_bg"
            android:text="Hủy"
            android:textColor="@color/text_dark"
            android:textSize="13sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/transparent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_save"
            style="@style/Widget.FitTrack.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1.6"
            android:text="Cập nhật khẩu phần"
            android:textSize="13sp"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>