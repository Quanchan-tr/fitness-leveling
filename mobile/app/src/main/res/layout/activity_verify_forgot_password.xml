<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/screen_padding_top"
    android:paddingEnd="@dimen/screen_padding_horizontal"
    android:paddingBottom="@dimen/screen_padding_bottom"
    tools:context=".ui.auth.VerifyForgotPasswordFragment">

    <!-- Circle Back Button -->
    <ImageButton
        android:id="@+id/btn_back"
        style="@style/Widget.FitTrack.CircleBackButton"
        android:contentDescription="@string/cd_back_button"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Screen Title -->
    <TextView
        android:id="@+id/tv_title"
        style="@style/TextAppearance.FitTrack.ScreenTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/email_sent_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_back" />

    <!-- Screen Subtitle -->
    <TextView
        android:id="@+id/tv_subtitle"
        style="@style/TextAppearance.FitTrack.Subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:text="@string/email_sent_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <!-- Enter Code Label -->
    <TextView
        android:id="@+id/tv_code_label"
        style="@style/TextAppearance.FitTrack.InputLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/label_enter_code"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle" />

    <!-- 6-digit OTP Box Row -->
    <LinearLayout
        android:id="@+id/layout_otp_boxes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_code_label">

        <EditText
            android:id="@+id/edt_otp_1"
            style="@style/Widget.FitTrack.OtpInput"
            android:layout_marginEnd="6dp"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/edt_otp_2"
            style="@style/Widget.FitTrack.OtpInput"
            android:layout_marginEnd="6dp"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/edt_otp_3"
            style="@style/Widget.FitTrack.OtpInput"
            android:layout_marginEnd="6dp"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/edt_otp_4"
            style="@style/Widget.FitTrack.OtpInput"
            android:layout_marginEnd="6dp"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/edt_otp_5"
            style="@style/Widget.FitTrack.OtpInput"
            android:layout_marginEnd="6dp"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/edt_otp_6"
            style="@style/Widget.FitTrack.OtpInput"
            android:importantForAutofill="no" />

    </LinearLayout>

    <!-- Verify Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_verify"
        style="@style/Widget.FitTrack.PrimaryButton"
        android:layout_marginTop="32dp"
        android:text="@string/btn_verify"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_otp_boxes" />

    <!-- Resend prompt: Didn’t see your email? Resend -->
    <TextView
        android:id="@+id/tv_resend_prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:padding="@dimen/spacing_small"
        android:text="@string/resend_code_full"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_verify" />

</androidx.constraintlayout.widget.ConstraintLayout>
