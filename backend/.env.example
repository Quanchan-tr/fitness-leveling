# --- APPLICATION CONFIGURATION ---
APP_NAME="FitTrack AI"
APP_ENV=local
APP_KEY=base64:GENERATE_WITH_ARTISAN_KEY_GENERATE
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- DATABASE CONFIGURATION (POSTGRESQL) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fittrack
DB_USERNAME=fittrack_user
DB_PASSWORD=fittrack_password

# --- REDIS CONFIGURATION ---
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# --- QUEUE & SESSION CONFIGURATION ---
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# --- AWS / S3-COMPATIBLE STORAGE (MINIO) ---
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=fittrack-user-assets
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://minio:9000

# --- SANCTUM AUTHENTICATION ---
SANCTUM_TOKEN_EXPIRATION=43200  # Token lives for 30 days (minutes)

# --- AI (LLM) GATEWAY CONFIGURATION ---
AI_PROVIDER=openai
AI_API_KEY=sk-proj-YOUR_API_KEY_HERE
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=1

# --- INTERNAL PYTHON POSE WORKER ---
POSE_WORKER_URL=http://pose-worker:8001
POSE_WORKER_TIMEOUT_SECONDS=180
POSE_VIDEO_MAX_SIZE_MB=100
POSE_VIDEO_MAX_DURATION_SEC=60
