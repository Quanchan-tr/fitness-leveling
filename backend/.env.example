# --- APPLICATION CONFIGURATION ---
APP_NAME="FitnessLeveling AI"
APP_ENV=local                   # Production: đổi thành 'production'
APP_KEY=base64:GENERATE_WITH_ARTISAN_KEY_GENERATE
APP_DEBUG=true                  # Production: BẮT BUỘC đổi thành 'false'
APP_URL=http://localhost:8000   # Production: đổi thành http://<IP_VPS>:8000
CORS_ALLOWED_ORIGINS=*          # Danh sách origins được phép gọi API (hoặc dấu * cho tất cả)

# --- DATABASE CONFIGURATION (POSTGRESQL) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fitnessleveling
DB_USERNAME=fitnessleveling_user
DB_PASSWORD=fitnessleveling_password

# --- QUEUE CONFIGURATION ---
# MVP uses Laravel Database Queue. Queue state lives in the PostgreSQL `jobs` table.
# No Redis required.
QUEUE_CONNECTION=database

# --- CACHE CONFIGURATION ---
# MVP uses file-based cache. No dedicated cache server required.
CACHE_STORE=file

# --- SESSION CONFIGURATION ---
SESSION_DRIVER=file

# --- FILE STORAGE CONFIGURATION ---
# MVP uses Laravel Private Local Storage.
# Videos are stored at storage/app/private/pose-videos/{user_id}/{session_id}.{ext}
# No S3 / MinIO required.
FILESYSTEM_DISK=local

# --- SANCTUM AUTHENTICATION ---
SANCTUM_TOKEN_EXPIRATION=43200

# --- AI (LLM) GATEWAY CONFIGURATION ---
AI_PROVIDER=openai
AI_API_KEY=sk-proj-YOUR_API_KEY_HERE
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=1

# --- INTERNAL PYTHON POSE WORKER ---
POSE_WORKER_URL=http://pose-worker:8001
POSE_WORKER_TIMEOUT_SECONDS=180
POSE_VIDEO_MAX_SIZE_MB=100
POSE_VIDEO_MAX_DURATION_SEC=60

# --- MAIL CONFIGURATION (GMAIL SMTP) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_digit_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="your_email@gmail.com"
MAIL_FROM_NAME="FitTrack AI"

